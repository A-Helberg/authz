{:paths ["src" "snippets" "resources"]

 :deps
 {;; the library this tutorial teaches (brings Datomic peer for the generator)
  authz/authz {:local/root ".."}

  ;; the docs framework: Reagent-style hiccup on SolidJS + the guide shell
  solidjclj/solidclj      {:git/url   "https://github.com/A-Helberg/solidclj"
                           :git/sha   "441b858f9b7c8b3fe8bccb02652bea98561518e9"
                           :deps/root "lib/solidclj"}
  solidjclj/solidclj-docs {:git/url   "https://github.com/A-Helberg/solidclj"
                           :git/sha   "441b858f9b7c8b3fe8bccb02652bea98561518e9"
                           :deps/root "lib/solidclj-docs"}}

 :aliases
 {:cljs {:extra-deps {thheller/shadow-cljs {:mvn/version "2.28.17"}}}

  :test {:extra-paths ["test"]}

  ;; JVM step: evaluate every tutorial snippet against in-memory Datomic and
  ;; capture the results the site displays
  :gen {:exec-fn authz.docs-gen/run}}}
